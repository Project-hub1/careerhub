# REQUIRED in production
SECRET_KEY=replace-with-a-long-random-secret

# Production PostgreSQL URL. Render/Railway can provide this as DATABASE_URL.
# Example: postgresql://user:password@host:5432/careerhub
DATABASE_URL=postgresql://user:password@host:5432/careerhub

# Keep reset URLs hidden in production.
DEV_SHOW_RESET_LINK=0

# Optional
JOBS_PER_PAGE=20
SESSION_COOKIE_SECURE=1
